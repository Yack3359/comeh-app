# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://comeh:change-me@localhost:5432/comeh?schema=public"

# Public URL of the application. Use the deployed HTTPS URL in production.
NEXTAUTH_URL="http://localhost:3000"

# Signing secret for NextAuth sessions.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Default administrator created by `npm run prisma:seed`.
# ADMIN_PASSWORD est obligatoire (>= 12 caractères) : le seed échoue si absent, aucun mot de passe par défaut n'est utilisé.
ADMIN_EMAIL="admin@comeh.local"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Administrateur COMEH"
